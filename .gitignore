# Research checkouts, cloned by scripts/sync_pool.sh. Large, and someone
# else's code -- regenerate with `./scripts/sync_pool.sh` rather than committing.
_research/

# Local verifier build output (tens of GB).
.verifier/
.venv/
__pycache__/
*.pyc

# Submission working state. NEVER commit: these cite payments, name wallets, and
# the private keys live beside them.
submission.zip
submission.plan.json
challenges/
drafts/
*.session.json
session.json

# Local scratch: the downloaded elan installer and working copies of scripts
# that are tracked under scripts/. Never commit the installer.
_work/

# Search output, written to the working directory when the search scripts run.
green12_*.json

# Agent scratch.
.hermes/
.DS_Store
